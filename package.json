{
  "name": "product-search-app",
  "version": "1.0.0",
  "description": "A ChatGPT app for searching products using an API",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npx serve assets -p 4444",
    "dev": "vite",
    "server:node": "node dist/server/product-search-server.js",
    "server:dev": "tsx src/server/product-search-server.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["openai", "apps-sdk", "chatgpt", "product-search", "typescript"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4"
  },
  "devDependencies": {
    "vite": "^5.0.0",
    "serve": "^14.2.0",
    "jest": "^29.7.0",
    "@jest/globals": "^29.7.0",
    "typescript": "^5.3.3",
    "@types/node": "^20.10.6",
    "tsx": "^4.7.0",
    "ts-jest": "^29.1.1",
    "@swc/jest": "^0.2.29"
  }
}
