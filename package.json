{
  "name": "product-search-app",
  "version": "1.0.0",
  "description": "A ChatGPT app for searching products using an API",
  "type": "module",
  "scripts": {
    "build": "node build-all.mts",
    "serve": "npx serve assets -p 4444",
    "dev": "vite",
    "server:node": "node src/server/product-search-server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },
  "keywords": ["openai", "apps-sdk", "chatgpt", "product-search"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4"
  },
  "devDependencies": {
    "vite": "^5.0.0",
    "serve": "^14.2.0",
    "jest": "^29.7.0",
    "@jest/globals": "^29.7.0"
  }
}
